#!/usr/bin/env python3
"""lab: the one command a learner needs.

    lab                 which labs exist, what is done
    lab 3               start lab 3: objective, evidence, what to find
    lab check 3 VALUE   submit the value you found
    lab progress        score and badges
    lab reset           clear your progress

Nothing here needs root and nothing leaves the container.
"""
import hashlib
import json
import os
import sys

FLAGS = "/usr/local/share/cpia/flags.json"
PROGRESS = "/labs/reports/progress.json"
SHEETS = "/labs/sheets"

GOALS = {
 "L01": ("Recover the case reference without touching the original evidence.",
         "Hash /labs/work/samples/payload.bin with sha256sum and give the first eight characters."),
 "L02": ("Name the victim host from the capture alone.", "Find the client MAC address in the pcap."),
 "L03": ("Fingerprint the local victim web service.",
         "Ask the service on http://127.0.0.1:8080/ which version it runs."),
 "L04": ("Find the file whose permissions break policy.",
         "Look for a set-user-ID bit where a script should never have one."),
 "L05": ("Pull the author out of a suspicious invoice.",
         "Read the document metadata, do not trust the visible text."),
 "L06": ("Say what the host keeps asking for.", "Count DNS queries in /labs/work/logs/dns.log."),
 "L07": ("Name the command and control address.", "Find the host with the most HTTP requests in the pcap."),
 "L08": ("Separate discovery noise from a real intrusion.",
         "Identify the multicast address that hosts probe on the local network."),
 "L09": ("Acquire the image and find a deleted file.", "Export the E01 and list the MFT for logfile1.txt."),
 "L10": ("Find the Run key that persists malware.", "Read the exported hive and give the value name."),
 "L11": ("Say which Windows build the memory image came from.", "Run vol windows.info.Info."),
 "L12": ("Extract the host a malicious library talks to.", "strings the DLL and find the URL host."),
 "L13": ("Recognise a binary that has been stripped.", "Ask file what happened to the section headers."),
 "L14": ("Reconstruct the incident end to end.", "Name the proxy domain the host was steered to."),
}

BADGES = [(0, "Recruit"), (3, "Analyst"), (7, "Senior analyst"), (11, "Incident lead"), (14, "CPIA practitioner")]


def load_progress():
    try:
        return json.load(open(PROGRESS))
    except Exception:
        return {"done": [], "attempts": 0}


def save(prog):
    os.makedirs(os.path.dirname(PROGRESS), exist_ok=True)
    json.dump(prog, open(PROGRESS, "w"), indent=1)


def badge(n):
    name = BADGES[0][1]
    for need, label in BADGES:
        if n >= need:
            name = label
    return name


def listing():
    prog = load_progress()
    done = set(prog["done"])
    print("\n  CPIA Kali lab: 14 labs, one container\n")
    for lid, (title, _) in GOALS.items():
        mark = "done" if lid in done else "    "
        print(f"  [{mark}] {lid}  {title}")
    print(f"\n  {len(done)} of 14 complete.  Badge: {badge(len(done))}")
    print("  Start one with:  lab 7      Check an answer with:  lab check 7 <value>\n")


def start(num):
    lid = f"L{int(num):02d}"
    if lid not in GOALS:
        sys.exit(f"  no lab {num}; run 'lab' to see the list")
    prog = load_progress()
    state = "already complete" if lid in prog["done"] else "open"
    print(f"\n  {lid}  {GOALS[lid][0]}\n  Status: {state}\n")
    print(f"  What to find: {GOALS[lid][1]}\n")
    sheet = os.path.join(SHEETS, f"{lid}.md")
    if os.path.exists(sheet):
        print(f"  Full sheet: {sheet}")
        print(f"  Read it with:  less {sheet}\n")
    print(f"  Submit with:   lab check {int(num)} <value>\n")


def check(num, value):
    lid = f"L{int(num):02d}"
    flags = json.load(open(FLAGS))
    if lid not in flags:
        sys.exit("  unknown lab")
    entry = flags[lid]
    got = hashlib.sha256((entry["salt"] + value.strip().lower()).encode()).hexdigest()
    prog = load_progress()
    prog["attempts"] = prog.get("attempts", 0) + 1
    if got == entry["sha256"]:
        if lid not in prog["done"]:
            prog["done"].append(lid)
        save(prog)
        n = len(prog["done"])
        print(f"\n  CORRECT. {lid} complete. {n} of 14. Badge: {badge(n)}\n")
        if n == 14:
            print("  All fourteen labs complete. You have finished the CPIA practical track.\n")
    else:
        save(prog)
        print(f"\n  Not that value. Look again at: {GOALS[lid][1]}\n")


def progress():
    prog = load_progress()
    n = len(prog["done"])
    print(f"\n  complete: {n} of 14   badge: {badge(n)}   attempts: {prog.get('attempts', 0)}\n")
    for lid in GOALS:
        print(f"  {'x' if lid in prog['done'] else '.'} {lid}")


def reset():
    save({"done": [], "attempts": 0})
    print("  progress cleared")


if __name__ == "__main__":
    args = sys.argv[1:]
    if not args:
        listing()
    elif args[0] == "check" and len(args) >= 3:
        check(args[1], " ".join(args[2:]))
    elif args[0] == "progress":
        progress()
    elif args[0] == "reset":
        reset()
    elif args[0].isdigit():
        start(args[0])
    else:
        print(__doc__)
